---
// Registro público de cambios: commits que tocan datos, esquemas o documentación, leídos de git en el build.
import { execFileSync } from "node:child_process";
import Base from "../layouts/Base.astro";
import { retired, url } from "../lib/data";
type C = { hash: string; date: string; subject: string; files: number };
let commits: C[] = [];
try {
  const out = execFileSync("git", ["log", "--date=short", "--pretty=format:%H%x1f%ad%x1f%s", "--shortstat", "--", "data/canonical", "schemas", "docs"], { encoding: "utf8" });
  const blocks = out.split(/\n(?=[0-9a-f]{40}\x1f)/);
  commits = blocks.map((b) => {
    const [head, stat = ""] = b.split("\n").filter(Boolean).reduce((acc: string[], l) => (acc.length === 0 ? [l] : [acc[0], (acc[1] ?? "") + l]), []);
    const [hash, date, subject] = head.split("\x1f");
    return { hash, date, subject, files: Number(stat.match(/(\d+) files? changed/)?.[1] ?? 0) };
  }).filter((c) => c.hash);
} catch { commits = []; }
const retirados = Object.entries(retired).flatMap(([k, list]) => list.map((o) => ({ k, o })));
const REPO = "https://github.com/pedri77/memoria-viva";
---
<Base title="Registro de cambios" index={false} description="Historial público de cambios en datos, esquemas y documentación.">
  <h1>Registro de cambios</h1>
  <p>Todo cambio en los datos queda en el historial público del repositorio. Aquí se listan los que afectan a datos, esquemas o documentación. Para notificar un error, usa el <a href={`${REPO}/issues/new?template=correccion.yml`}>formulario de correcciones</a>.</p>
  <h2>Contenidos retirados</h2>
  {retirados.length ? <ul>{retirados.map(({ o }) => <li>{o.review.date} · {o.title ?? o.canonical_name ?? o.id}: {o.review.note}</li>)}</ul> : <p class="meta">Ninguno.</p>}
  <h2>Cambios</h2>
  {commits.length ? (
    <ol class="cambios" reversed>
      {commits.map((c) => <li><span class="meta">{c.date}</span> · <a href={`${REPO}/commit/${c.hash}`}>{c.subject}</a> <span class="meta">({c.files} ficheros)</span></li>)}
    </ol>
  ) : <p class="meta">Historial no disponible en esta compilación. Consulta <a href={`${REPO}/commits/main`}>el repositorio</a>.</p>}
</Base>
