    let sucio = true;
    const marcar = () => { sucio = true; };
    function fotograma() {
      if (sucio) { sucio = false; apertura(); relatos.forEach((r) => relato(r)); carrete(); }
      requestAnimationFrame(fotograma);
    }
    const iniciar = () => {
      relatos.forEach((r) => relato(r, true));
      requestAnimationFrame(() => root.classList.add("viva"));
    };
