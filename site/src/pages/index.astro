---
/*
Portada · «Del documento al mapa»
Metáfora: el mapa de 1930 se dibuja y se llena de datos; cada cifra lleva a su documento.
Sin imágenes generadas: todo sale de data/canonical y de las capas públicas (ver lib/portada.ts).

Apertura · 220 svh fijada
  al cargar   se dibujan los límites provinciales de 1930 (trazo, 1,6 s; inmediato con movimiento reducido)
  0.05 – 0.85  el año corre de 1931 a 1939 y se encienden los acontecimientos con lugar
Saber leer · relato con pasos (mapa fijo, textos en flujo normal)
  paso 0 censo 1920 · paso 1 censo 1930 (afirmación de la narrativa) · paso 2 mujeres 1930
  el color de cada provincia se interpola entre pasos según la posición del scroll
Votar · relato con pasos
  1931 · Constitución (art. 36) · 1933 · 1936; los mapas de circunscripciones se funden
La tierra · relato con pasos
  censo de 1930 (grupo II) · fila «Diversas» · términos municipales 1931 · Reforma Agraria 1932 · 1935;
  dos mapas con escalas distintas que se funden (no se interpolan) y leyenda que cambia con el paso
Cronología · carrete horizontal fijado, alto calculado en JS según el ancho de la pista
Índice · flujo normal · Cierre · wordmark
Sin JS: todas las secciones en flujo normal, mapas en su estado final, carrete con scroll horizontal.
Movimiento reducido: sin transiciones autónomas; lo ligado al scroll se mantiene.
*/
import Base from "../layouts/Base.astro";
import Fuente from "../components/Fuente.astro";
import { events, documents, sources, stories, places, indicators, url, byId } from "../lib/data";
import { TYPE_LABEL } from "../lib/atlas";
import { MAPA, provincias, circunscripciones, puntos, afirmacion, docIndicador, cronologia } from "../lib/portada";

const provs = provincias();
const circ = circunscripciones();
const pts = puntos();
const conLugar = new Set(pts.map((p) => p.id)).size;
const nProv = places.filter((p) => p.place_type === "provincia").length;
const fmtFecha = (d: string, prec: string) => {
  const [y, m, dd] = d.split("-").map(Number);
  const mes = new Date(Date.UTC(y, m - 1, dd || 1)).toLocaleDateString("es-ES", { month: "long", timeZone: "UTC" });
  return prec === "dia" ? `${dd} de ${mes} de ${y}` : prec === "mes" ? `${mes} de ${y}` : String(y);
};
const scene = (sid: string, scid: string) => byId(stories, sid)?.scenes.find((s: any) => s.id === scid);

const docA20 = docIndicador("ind-alfab-total-prov", "1920");
const docA30 = docIndicador("ind-alfab-total-prov", "1930");
const docM30 = docIndicador("ind-alfab-mujeres-prov", "1930");
const leer = [
  { frame: "a20", fecha: "Diciembre de 1920", titulo: "Censo de 1920",
    texto: "Porcentaje de la población de hecho que sabía leer, provincia a provincia. El censo de 1920 no da la cifra separada de Las Palmas y Santa Cruz de Tenerife: Canarias queda sin color.",
    doc: docA20 && { id: docA20.id, title: docA20.title, locator: "" }, atlas: "capa=censo&ind=ind-alfab-total-prov&censo=1920" },
  { frame: "a30", fecha: "Diciembre de 1930", titulo: "Censo de 1930", claim: afirmacion("story-escuelas-republica", "diagnostico", 2), atlas: "capa=censo&ind=ind-alfab-total-prov&censo=1930" },
  { frame: "m30", fecha: "Diciembre de 1930", titulo: "Las mujeres, en 1930",
    texto: "El mismo censo, solo para las mujeres: porcentaje de las mujeres de cada provincia que sabían leer.",
    doc: docM30 && { id: docM30.id, title: docM30.title, locator: "" }, atlas: "capa=censo&ind=ind-alfab-mujeres-prov&censo=1930" },
];
const votar = [
  ["1931", "constituyentes", 1], ["1931", "constitucion", 0], ["1933", "elecciones-1933", 1], ["1936", "elecciones-1936", 0],
].map(([frame, scid, i]) => {
  const sc = scene("story-votar-republica", scid as string);
  return { frame, fecha: sc.date_label, titulo: sc.heading, claim: afirmacion("story-votar-republica", scid as string, i as number), atlas: sc.atlas_query };
});

// «La tierra»: peso agrario y fila «Diversas» del censo de 1930; pasos legales con afirmaciones de la cronología.
const indAgr = byId(indicators, "ind-prof-agraria-prov"), indDiv = byId(indicators, "ind-prof-diversas-prov");
const v30 = (ind: any) => Object.fromEntries((ind?.observations ?? []).filter((o: any) => o.period === "1930").map((o: any) => [o.place_id.slice(-2), o.value]));
const agr = v30(indAgr), div = v30(indDiv);
const rango = (m: Record<string, number | null>) => { const xs = Object.values(m).filter((v): v is number => v != null); return [Math.floor(Math.min(...xs)), Math.ceil(Math.max(...xs))]; };
const domAgr = rango(agr), domDiv = rango(div);
const docProf = byId(documents, "doc-ine-censo1930-profesiones");
const claimEv = (eid: string, i: number) => { const e = byId(events, eid); const c = e.claims[i]; const d = byId(documents, c.evidence[0].document_id); return { text: c.text, doc: { id: d.id, title: d.title, locator: c.evidence[0].locator ?? "" }, ev: eid }; };
const extremo = (m: Record<string, number | null>, signo: number) => {
  const [c, v] = Object.entries(m).filter(([, v]) => v != null).sort((x: any, y: any) => signo * (y[1] - x[1]))[0] as [string, number];
  return `${String(v).replace(".", ",")} % de ${provs.find((p) => p.code === c)?.name ?? c}`;
};
const agrupar = (cs: any[]) => {
  const m = new Map<string, { id: string; title: string; locs: string[] }>();
  for (const c of cs) { const g = m.get(c.doc.id) ?? { id: c.doc.id, title: c.doc.title, locs: [] }; if (c.doc.locator && !g.locs.includes(c.doc.locator)) g.locs.push(c.doc.locator); m.set(c.doc.id, g); }
  return [...m.values()];
};
const tierra = [
  { frame: "agr", fecha: "Diciembre de 1930", titulo: "El campo en 1930", min: domAgr[0], max: domAgr[1],
    textos: [`Porcentaje de la población con profesión que el censo clasifica en el grupo II: explotación de montes, agricultura y ganadería. Va del ${extremo(agr, -1)} al ${extremo(agr, 1)}.`],
    doc: docProf && { id: docProf.id, title: docProf.title, locator: "" }, atlas: "capa=censo&ind=ind-prof-agraria-prov&censo=1930" },
  { frame: "div", fecha: "Diciembre de 1930", titulo: "Lo que el censo no aclara", min: domDiv[0], max: domDiv[1],
    textos: ["El mismo censo pone a mucha gente en una fila de «Diversas» que no dice a qué se dedicaba; parte serían jornaleros del campo. Donde esa fila es grande, el peso real de la agricultura puede ser mayor que el del mapa anterior. A las tablas de algunas provincias les faltan páginas: en el mapa anterior, Gerona y Vizcaya quedan sin dato; en este, Cádiz."],
    doc: docProf && { id: docProf.id, title: docProf.title, locator: "" }, atlas: "capa=censo&ind=ind-prof-diversas-prov&censo=1930" },
  { frame: "agr", fecha: "Abril de 1931", titulo: "Los braceros del término", min: domAgr[0], max: domAgr[1], pasos: [claimEv("evt-1931-04-30-terminos-municipales", 0), claimEv("evt-1931-04-30-terminos-municipales", 1)] },
  { frame: "agr", fecha: "Septiembre de 1932", titulo: "La Ley de Reforma Agraria", min: domAgr[0], max: domAgr[1], pasos: [claimEv("evt-1932-09-15-reforma-agraria", 0), claimEv("evt-1932-09-15-reforma-agraria", 1)] },
  { frame: "agr", fecha: "1935", titulo: "Arrendamientos y «reforma de la reforma»", min: domAgr[0], max: domAgr[1], pasos: [claimEv("evt-1935-03-24-arrendamientos-rusticos", 0), claimEv("evt-1935-08-10-reforma-reforma-agraria", 0), claimEv("evt-1935-08-10-reforma-reforma-agraria", 1)] },
];
const tT = (v: number | null | undefined, d: number[]) => v == null ? null : ((v - d[0]) / (d[1] - d[0])).toFixed(3);

// Dominios de color: de los propios datos, no fijados a mano.
const vLeer = provs.flatMap((p) => [p.a20, p.a30, p.m30]).filter((v): v is number => v != null);
const vPart = Object.values(circ).flat().map((c) => c.part).filter((v): v is number => v != null);
const dom = { leer: [Math.floor(Math.min(...vLeer)), Math.ceil(Math.max(...vLeer))], part: [Math.floor(Math.min(...vPart)), Math.ceil(Math.max(...vPart))] };
const tLeer = (v: number | null) => v == null ? null : ((v - dom.leer[0]) / (dom.leer[1] - dom.leer[0])).toFixed(3);
const tPart = (v: number | null) => v == null ? null : ((v - dom.part[0]) / (dom.part[1] - dom.part[0])).toFixed(3);
const nf = (v: number | null) => v == null ? "sin dato" : `${v.toLocaleString("es-ES", { maximumFractionDigits: 1 })} %`;

const crono = cronologia();
const indice = [
  { href: "/atlas/", t: "Atlas", d: `Censos de 1920 a 1940 y elecciones de 1931, 1933 y 1936 sobre los límites de 1930, con ${events.length} acontecimientos situados.` },
  { href: "/historias/", t: "Historias", d: `${stories.length} narrativas en borrador: ${stories.map((s) => `«${s.title}»`).join(" y ")}.` },
  { href: "/acontecimientos/", t: "Cronología", d: `${events.length} acontecimientos de 1931 a 1939, cada uno con su documento.` },
  { href: "/documentos/", t: "Archivo", d: `${documents.length} fichas documentales con su custodio, su signatura y sus condiciones de uso.` },
  { href: "/datos/", t: "Datos abiertos", d: "Todo en JSON y CSV, con la licencia y la atribución de cada dato." },
  { href: "/lagunas/", t: "Lagunas", d: "Lo que se ha buscado sin encontrarlo, dónde se buscó y qué fuentes probar." },
  { href: "/metodologia/", t: "Metodología", d: "Cómo se documenta cada afirmación, cómo se revisa y cómo notificar un error." },
];
---
<Base index={false} wide title="Inicio" description="Atlas y archivo documental de la Segunda República y la Guerra Civil (1931-1939). Cada afirmación enlaza al documento que la sostiene.">
  <div class="portada">

    <section class="apertura" aria-labelledby="h-portada">
      <div class="fijo">
        <div class="ap-texto">
          <h1 id="h-portada">Historia contemporánea de España, <em>documento a documento</em></h1>
          <p class="ap-lead">Un atlas y archivo de la Segunda República y la Guerra Civil (1931-1939) en el que cada afirmación enlaza a la fuente que la sostiene, con su fecha, su lugar, su grado de certeza y sus condiciones de uso.</p>
          <p class="ap-cifras">{events.length} acontecimientos, {documents.length} fichas documentales, {nProv} provincias y {sources.length} fuentes registradas.</p>
          <p class="ap-acciones"><a class="boton" href={url("/atlas/")}>Abrir el atlas</a> <a href="#saber-leer">Empezar a leer</a></p>
          <p class="meta ap-aviso">Proyecto en construcción: todo está en revisión. Antes de seguir, lee <a href={url("/metodologia/")}>cómo se documenta</a>.</p>
        </div>
        <figure class="ap-mapa" aria-hidden="true">
          <svg viewBox={`0 0 ${MAPA.w} ${MAPA.h}`} class="mapa mapa-ap">
            <g class="prov">{provs.map((p) => <path d={p.d} pathLength="1" data-tip={p.name} />)}</g>
            <rect class="recuadro" x="18" y={MAPA.h - 150} width="232" height="118" pathLength="1" />
            <g class="pts">{pts.map((p) => <circle cx={p.x} cy={p.y} r="6" data-y={p.year} />)}</g>
          </svg>
          <p class="anio"><span class="anio-n">1931</span></p>
          <figcaption class="meta">Límites provinciales de 1930. Los puntos son los lugares de los {conLugar} acontecimientos con lugar concreto; los otros {events.length - conLugar} son de ámbito estatal.</figcaption>
        </figure>
      </div>
    </section>

    <section class="relato" id="saber-leer" data-relato="leer" aria-labelledby="h-leer">
      <header class="rel-cab">
        <h2 id="h-leer">Saber leer</h2>
        <p>Qué parte de la población sabía leer, provincia a provincia, según los censos de 1920 y 1930.</p>
      </header>
      <div class="rel-cuerpo">
        <figure class="rel-mapa" aria-hidden="true">
          <svg viewBox={`0 0 ${MAPA.w} ${MAPA.h}`} class="mapa">
            <defs><pattern id="rayado" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="6" height="6" class="ray-f" /><line x1="0" y1="0" x2="0" y2="6" class="ray-l" /></pattern></defs>
            <g class="coro">{provs.map((p) => (
              <path d={p.d} data-a20={tLeer(p.a20) ?? ""} data-a30={tLeer(p.a30) ?? ""} data-m30={tLeer(p.m30) ?? ""} class={p.a30 == null ? "nd" : undefined} style={p.a30 == null ? undefined : `--t:${tLeer(p.a30)}`}>
                <title>{p.name}: 1920, {nf(p.a20)}; 1930, {nf(p.a30)}; mujeres en 1930, {nf(p.m30)}</title>
              </path>
            ))}</g>
          </svg>
          <div class="leyenda"><span class="ley-et" data-label>Censo de 1930</span><span class="ley-barra"></span><span class="ley-min">{dom.leer[0]} %</span><span class="ley-max">{dom.leer[1]} %</span></div>
          <figcaption class="meta">INE, censos de 1920 y 1930, tomo II (CC BY 4.0). Sin dato: rayado.</figcaption>
        </figure>
        <ol class="pasos">
          {leer.map((s) => (
            <li class="paso" data-frame={s.frame} data-label={s.titulo}>
              <div class="paso-caja">
                <p class="meta">{s.fecha}</p>
                <h3>{s.titulo}</h3>
                <p>{s.claim ? s.claim.text : s.texto}</p>
                <p class="meta"><Fuente doc={s.claim ? s.claim.doc : s.doc} /> <a href={url(`/atlas/?${s.atlas}`)}>Ver en el atlas</a>{s.claim && <> · <a href={url(`/historias/${s.claim.story}/#${s.claim.scene}`)}>Seguir en la historia</a></>}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="relato" id="votar" data-relato="votar" aria-labelledby="h-votar">
      <header class="rel-cab">
        <h2 id="h-votar">Votar</h2>
        <p>Las tres elecciones generales de la República, con la participación en la primera vuelta de cada circunscripción.</p>
      </header>
      <div class="rel-cuerpo">
        <figure class="rel-mapa" aria-hidden="true">
          <svg viewBox={`0 0 ${MAPA.w} ${MAPA.h}`} class="mapa">
            {Object.entries(circ).map(([y, cs]) => (
              <g class="capa-elec" data-frame={y}>{cs.map((c) => <path d={c.d} class={c.part == null ? "nd" : undefined} style={c.part == null ? undefined : `--t:${tPart(c.part)}`}><title>{c.nombre}, {y}: participación {nf(c.part)}</title></path>)}</g>
            ))}
          </svg>
          <div class="leyenda"><span class="ley-et" data-label>Elecciones de 1931</span><span class="ley-barra part"></span><span class="ley-min">{dom.part[0]} %</span><span class="ley-max">{dom.part[1]} %</span></div>
          <figcaption class="meta">Participación por circunscripción. Atlas Electoral de la Segunda República (Rodon, Vall-Prat y Martín Álvarez, CC BY-NC-SA 4.0).</figcaption>
        </figure>
        <ol class="pasos">
          {votar.map((s) => (
            <li class="paso" data-frame={s.frame} data-label={`Elecciones de ${s.frame}`}>
              <div class="paso-caja">
                <p class="meta">{s.fecha}</p>
                <h3>{s.titulo}</h3>
                <p>{s.claim.text}</p>
                <p class="meta"><Fuente doc={s.claim.doc} /> {s.atlas && <><a href={url(`/atlas/?${s.atlas}`)}>Ver en el atlas</a> · </>}<a href={url(`/historias/${s.claim.story}/#${s.claim.scene}`)}>Seguir en la historia</a></p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="relato" id="tierra" data-relato="tierra" aria-labelledby="h-tierra">
      <header class="rel-cab">
        <h2 id="h-tierra">La tierra</h2>
        <p>Cuánta gente vivía del campo en cada provincia y qué normas cambiaron su trabajo entre 1931 y 1935.</p>
      </header>
      <div class="rel-cuerpo">
        <figure class="rel-mapa" aria-hidden="true">
          <svg viewBox={`0 0 ${MAPA.w} ${MAPA.h}`} class="mapa">
            <defs><pattern id="rayado-t" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="6" height="6" class="ray-f" /><line x1="0" y1="0" x2="0" y2="6" class="ray-l" /></pattern></defs>
            {[["agr", agr, domAgr, "trabaja en el campo"], ["div", div, domDiv, "en la fila «Diversas»"]].map(([fr, m, d, txt]: any) => (
              <g class="capa-elec capa-tierra" data-frame={fr}>{provs.map((p) => { const v = m[p.code]; return (
                <path d={p.d} class={v == null ? "nd" : undefined} style={v == null ? undefined : `--t:${tT(v, d)}`} data-tip={`${p.name}: ${v == null ? "sin dato" : `${String(v).replace(".", ",")} % ${txt}`}`} />); })}</g>
            ))}
          </svg>
          <div class="leyenda"><span class="ley-et" data-label>El campo en 1930</span><span class="ley-barra"></span><span class="ley-min" data-ley-min>{domAgr[0]} %</span><span class="ley-max" data-ley-max>{domAgr[1]} %</span></div>
          <figcaption class="meta">% de la población con profesión. INE, censo de 1930, tomo III (CC BY 4.0). Sin dato: rayado.</figcaption>
        </figure>
        <ol class="pasos">
          {tierra.map((s) => (
            <li class="paso" data-frame={s.frame} data-label={s.frame === "div" ? "«Diversas», 1930" : "El campo en 1930"} data-min={s.min} data-max={s.max}>
              <div class="paso-caja">
                <p class="meta">{s.fecha}</p>
                <h3>{s.titulo}</h3>
                {s.textos?.map((t) => <p>{t}</p>)}
                {s.pasos?.map((c) => <p>{c.text}</p>)}
                <p class="meta">
                  {s.doc && <><Fuente doc={s.doc} /> </>}
                  {s.pasos && <>Fuentes: {agrupar(s.pasos).map((g, i) => <>{i > 0 && " · "}<a href={url(`/documentos/${g.id}/`)}>{g.title}</a>{g.locs.length ? `, ${g.locs.join("; ")}` : ""}</>)}. </>}
                  {s.atlas && <a href={url(`/atlas/?${s.atlas}`)}>Ver en el atlas</a>}
                  {s.pasos && <a href={url(`/acontecimientos/${s.pasos[0].ev}/`)}>Ver en la cronología</a>}
                </p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="carrete" aria-labelledby="h-crono">
      <div class="fijo">
        <header class="car-cab">
          <h2 id="h-crono">Ocho años, {events.length} acontecimientos</h2>
          <p><a href={url("/acontecimientos/")}>Ver la cronología completa</a></p>
        </header>
        <div class="pista-marco">
          <ol class="pista">
            {crono.map((e, i) => (
              <li class={`hito ${i % 2 ? "abajo" : "arriba"}`} data-y={e.date.slice(0, 4)}>
                {(i === 0 || crono[i - 1].date.slice(0, 4) !== e.date.slice(0, 4)) && <span class="hito-anio" aria-hidden="true">{e.date.slice(0, 4)}</span>}
                <p class="meta"><time datetime={e.date}>{fmtFecha(e.date, e.prec)}</time> · {TYPE_LABEL[e.type] ?? e.type}</p>
                <a href={url(`/acontecimientos/${e.id}/`)}>{e.title}</a>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="indice" aria-labelledby="h-indice">
      <h2 id="h-indice">Por dónde seguir</h2>
      <ul>
        {indice.map((x) => (
          <li><a href={url(x.href)}><span class="ind-t">{x.t}</span><span class="ind-d">{x.d}</span><svg class="flecha" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg></a></li>
        ))}
      </ul>
    </section>

    <div class="cierre" aria-hidden="true">
      <svg viewBox="0 0 1000 150"><text x="0" y="118" textLength="1000" lengthAdjust="spacingAndGlyphs">Memoria Viva</text></svg>
    </div>
  </div>
</Base>

<script>
  // Un solo bucle rAF. El scroll marca «sucio»; cada fotograma recalcula solo lo visible.
  const root = document.querySelector<HTMLElement>(".portada");
  if (root) {
    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
    const tramo = (p: number, a: number, b: number) => clamp((p - a) / (b - a));
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    const progresoFijado = (el: HTMLElement) => {
      const r = el.getBoundingClientRect(); const rango = r.height - innerHeight;
      return { p: rango > 0 ? clamp(-r.top / rango) : 1, visible: r.bottom > 0 && r.top < innerHeight };
    };

    // Apertura
    const ap = root.querySelector<HTMLElement>(".apertura")!;
    const dots = [...ap.querySelectorAll<SVGCircleElement>(".pts circle")];
    const anioN = ap.querySelector<HTMLElement>(".anio-n")!;
    let pAp = -1;
    function apertura() {
      const { p, visible } = progresoFijado(ap);
      if (!visible || Math.abs(p - pAp) < 0.0002) return;
      pAp = p;
      const y = 1931 + Math.round(8 * tramo(p, 0.05, 0.85));
      if (anioN.textContent !== String(y)) anioN.textContent = String(y);
      for (const d of dots) d.classList.toggle("on", Number(d.dataset.y) <= y && p > 0.04);
    }

    // Relatos: posición continua entre pasos según el centro de la pantalla
    type Relato = { el: HTMLElement; tipo: string; pasos: HTMLElement[]; label: HTMLElement; last: number; prov?: SVGPathElement[]; capas?: SVGGElement[] };
    const relatos: Relato[] = [...root.querySelectorAll<HTMLElement>("[data-relato]")].map((el) => ({
      el, tipo: el.dataset.relato!, pasos: [...el.querySelectorAll<HTMLElement>(".paso")], label: el.querySelector<HTMLElement>("[data-label]")!, last: -1,
