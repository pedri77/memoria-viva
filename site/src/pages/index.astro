      if (r.label.textContent !== et) {
        r.label.textContent = et;
        const pa = r.pasos[activo], mn = r.el.querySelector("[data-ley-min]"), mx = r.el.querySelector("[data-ley-max]");
        if (pa.dataset.min && mn && mx) { mn.textContent = `${pa.dataset.min} %`; mx.textContent = `${pa.dataset.max} %`; }
      }
