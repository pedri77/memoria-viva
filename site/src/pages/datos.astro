---
import Base from "../layouts/Base.astro";
import MiniMapa from "../components/MiniMapa.astro";
import SerieNacional from "../components/SerieNacional.astro";
import sn from "../data/series_nacionales.json";
import { indicators, places, byId, url } from "../lib/data";
const fmt = (v: number | null, unit: string) =>
  v === null ? "sin dato" : unit.startsWith("habitantes") ? v.toLocaleString("es-ES", { minimumFractionDigits: 1, maximumFractionDigits: 1 }) : v.toLocaleString("es-ES");
const ordered = [...indicators].sort((a, b) => a.id.localeCompare(b.id));
const provs = places.filter((p) => p.id.startsWith("plc-prov-")).sort((a, b) => a.canonical_name.localeCompare(b.canonical_name, "es"));
const PER = (i: any) => [...new Set(i.observations.map((o: any) => o.period as string))].sort() as string[];
const val = (i: any, pid: string, y: string) => i.observations.find((o: any) => o.place_id === pid && o.period === y)?.value ?? null;
const TEMAS: [string, string, string[]][] = [
  ["poblacion", "Población", ["ind-pob-hecho-prov", "ind-pob-derecho-prov", "ind-densidad-prov"]],
  ["educacion", "Saber leer", ["ind-alfab10-total-prov", "ind-alfab10-varones-prov", "ind-alfab10-mujeres-prov", "ind-alfab-total-prov", "ind-alfab-varones-prov", "ind-alfab-mujeres-prov"]],
  ["trabajo", "Trabajo", ["ind-prof-agraria-prov", "ind-prof-agraria-varones-prov", "ind-prof-diversas-prov"]],
  ["reforma", "Propiedad y reforma agraria", ["ind-ra-riqueza-grandes-prov", "ind-ra-asentados-prov", "ind-ra-superficie-expropiada-prov", "ind-ra-expropiable-grandeza-prov"]],
  ["mortalidad", "Mortalidad y hambre", ["ind-sobremortalidad-prov", "ind-mortalidad-infantil-prov", "ind-mortalidad-prov", "ind-coste-vida-alimentacion-prov", "ind-coste-vida-general-prov", "ind-racion-aceite-prov", "ind-racion-azucar-prov", "ind-racion-patatas-prov"]],
  ["hoy", "Memoria democrática hoy", ["ind-subv-memoria-local-prov"]],
];
const SN = (g: string) => (sn as any).series.filter((x: any) => x.grupo === g);
const GRUPOS_SN: [string, string, string, boolean][] = [
  ["salarios", "Salario real máximo por jornada, por oficio", "Índice nacional estimado por el INE del salario máximo por jornada descontada la subida de precios (1936 = 100): por debajo de la línea de 100, un jornal compraba menos que en 1936.", true],
  ["precios", "Coste de la vida", "Media ponderada de las capitales de provincia (julio de 1936 = 100). El detalle por capital está en «Mortalidad y hambre».", true],
  ["prisiones", "Población reclusa", "Reclusos en las prisiones a 1 de enero de cada año y, de ellos, los penados por lo que la fuente llama «delitos no comunes». No hay cifras de 1935 a 1938.", false],
];
const enTema = new Set(TEMAS.flatMap(([, , ids]) => ids));
const resto = ordered.filter((i) => !enTema.has(i.id)).map((i) => i.id);
if (resto.length) TEMAS.push(["otros", "Otros", resto]);
// Periodo que se muestra en el minimapa: 1930 si existe; si no, el de más observaciones con valor (el último en empate)
const periodoMapa = (i: any) => {
  const per = PER(i); if (per.includes("1930")) return "1930";
  const n = (y: string) => i.observations.filter((o: any) => o.period === y && o.value != null).length;
  return [...per].sort((a, b) => n(b) - n(a) || b.localeCompare(a))[0];
};
const series = Object.fromEntries(ordered.map((i) => [i.id, { concept: i.concept, unit: i.unit, per: PER(i),
  data: Object.fromEntries(provs.map((p) => [p.id, PER(i).map((y) => val(i, p.id, y))])) }]));
---
<Base index={false} title="Datos" description="Series por provincia: censos de 1920, 1930 y 1940 y series anuales, con método, advertencias de comparabilidad y descarga CSV.">
  <header class="datos-cab">
    <h1>Datos</h1>
    <p class="datos-lead">{ordered.length} indicadores por provincia: censos de 1920, 1930 y 1940, series anuales del movimiento natural de la población y las ayudas públicas de memoria de hoy. Cada uno dice de dónde sale, cómo se calcula y qué limita la comparación.</p>
    <nav class="temas" aria-label="Temas">{TEMAS.map(([id, t, ids]) => <a href={`#tema-${id}`}>{t} <span>{ids.length}</span></a>)}<a href="#tema-nacional">Series nacionales <span>{(sn as any).series.length}</span></a></nav>
    <p class="meta">Descarga: todo en <a href={url("/data/v1/indicators.json")}>JSON</a>, o cada indicador en CSV con su licencia y su atribución. Pasa el ratón por los mapas para ver cada provincia.</p>
  </header>

  <section class="card" aria-labelledby="graf-h">
    <h2 id="graf-h">Comparar provincias</h2>
    <form class="filtros" id="graf-form">
      <label>Indicador <select id="g-ind">{ordered.map((i) => <option value={i.id}>{i.concept}</option>)}</select></label>
      <label>Provincias (hasta 6) <select id="g-prov" multiple size="6">{provs.map((p) => <option value={p.id} selected={["plc-prov-28", "plc-prov-08", "plc-prov-42"].includes(p.id)}>{p.canonical_name}</option>)}</select></label>
    </form>
    <div id="grafico" aria-live="polite"></div>
    <p class="meta">El eje horizontal respeta la distancia entre años. El censo de 1940 se hizo tras la guerra: desplazamientos, exilio y mortalidad afectan a la comparación con 1930, y el tramo entre censos no es una tendencia observada.</p>
  </section>

  {TEMAS.map(([tid, titulo, ids]) => (
    <section class="tema" id={`tema-${tid}`} aria-labelledby={`h-${tid}`}>
      <h2 id={`h-${tid}`}>{titulo}</h2>
      {ids.map((id) => byId(indicators, id)).filter(Boolean).map((ind: any) => {
        const per = PER(ind), pm = periodoMapa(ind);
        const rows = provs.map((p) => ({ p, vals: per.map((y) => val(ind, p.id, y)) }));
        return (
          <article class="ind" id={ind.id}>
            <div class="ind-txt">
              <h3>{ind.concept}</h3>
              <p>{ind.definition}</p>
              <p class="meta">Unidad: {ind.unit} · {per.length === 1 ? per[0] : `${per[0]}-${per[per.length - 1]}`} ({per.length} {per.length === 1 ? "periodo" : "periodos"}) · <a href={url(`/data/v1/${ind.id}.csv`)} download>Descargar CSV</a> · <a href={url(`/atlas/?capa=censo&ind=${ind.id}&censo=${pm}`)}>Ver en el atlas</a></p>
              <details>
                <summary>Método y advertencias</summary>
                <p><strong>Método:</strong> {ind.method}</p>
                <p><strong>Comparabilidad:</strong> {ind.comparability_notes}</p>
              </details>
              <details>
                <summary>Tabla por provincia</summary>
                <div class="table-wrap">
                  <table>
                    <caption class="meta">{ind.concept} ({ind.unit})</caption>
                    <thead><tr><th scope="col">Provincia</th>{per.map((y) => <th scope="col" style="text-align:right">{y}</th>)}</tr></thead>
                    <tbody>{rows.map((r) => <tr><th scope="row" style="font-weight:400"><a href={url(`/lugares/${r.p.id}/`)}>{r.p.canonical_name}</a></th>{r.vals.map((v) => <td style="text-align:right">{fmt(v, ind.unit)}</td>)}</tr>)}</tbody>
                  </table>
                </div>
              </details>
            </div>
            <figure class="ind-mapa">
              <MiniMapa ind={ind} periodo={pm} ancho={260} />
              <figcaption class="meta">{pm} · cinco tramos del valor más bajo (claro) al más alto (oscuro)</figcaption>
            </figure>
          </article>
        );
      })}
    </section>
  ))}
  <section class="tema" id="tema-nacional" aria-labelledby="h-nacional">
    <h2 id="h-nacional">Series nacionales de la posguerra</h2>
    <p>Datos que los Anuarios solo publican para el conjunto de España. Cada punto enlaza con su tabla en la tabla de datos; las notas explican los años con cautelas.</p>
    {GRUPOS_SN.map(([g, t, d, r]) => SN(g).length > 0 && (
      <article class="sn-art" id={`sn-${g}`}>
        <h3>{t}</h3>
        <p>{d}</p>
        <SerieNacional series={SN(g)} titulo={t} ref100={r} />
        <details>
          <summary>Fuente y advertencias</summary>
          {SN(g).filter((x: any, i: number, arr: any[]) => arr.findIndex((y: any) => y.nota === x.nota) === i).map((x: any) => <p>{x.nota}</p>)}
          <p class="meta">Documentos: {[...new Set(SN(g).flatMap((x: any) => x.puntos.map((p: any) => p.documento)))].sort().map((d: any, i: number) => <>{i > 0 && " · "}<a href={url(`/documentos/${d}/`)}>{d.replace("doc-ine-", "")}</a></>)}</p>
        </details>
      </article>
    ))}
  </section>
  <script type="application/json" id="series" set:html={JSON.stringify(series)} />
</Base>
<style is:global>
  .datos-cab h1 { font-size: clamp(2.6rem, 1.6rem + 4vw, 4.6rem); letter-spacing: -0.03em; margin: .6em 0 .2em; font-variation-settings: "opsz" 60; }
  .datos-lead { font-size: 1.12rem; }
  .temas { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0; }
  .temas a { text-decoration: none; color: var(--ink); background: var(--surface); border: 1px solid var(--line); border-radius: 999px; padding: 6px 12px; font-size: .92rem; transition: border-color .25s var(--ease), color .25s var(--ease); }
  .temas a:hover { border-color: var(--accent); color: var(--accent); }
  .temas span { color: var(--muted); margin-left: 4px; font-variant-numeric: tabular-nums; }
  .tema { padding-top: 24px; }
  .tema > h2 { font-size: clamp(1.8rem, 1.3rem + 1.6vw, 2.6rem); letter-spacing: -0.02em; border-bottom: 1px solid var(--ink); padding-bottom: 8px; }
  .ind { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 16px 40px; padding: 20px 0 28px; border-bottom: 1px solid var(--line); }
  .ind h3 { margin: 0 0 6px; font-size: 1.3rem; }
  .ind-txt p { margin: 0 0 8px; }
  .ind details { margin: 6px 0; }
  .ind summary { cursor: pointer; color: var(--accent); }
  .ind-mapa { margin: 0; }
  .ind-mapa figcaption { margin-top: 4px; font-size: .78rem; }
  @media (max-width: 760px) { .ind { grid-template-columns: 1fr; } .ind-mapa { max-width: 280px; order: -1; } }
  .sn-art { padding: 20px 0 28px; border-bottom: 1px solid var(--line); }
  .sn-art h3 { margin: 0 0 6px; font-size: 1.3rem; }
  .filtros { display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: start; margin: 8px 0 16px; }
  .filtros label { display: grid; gap: 4px; color: var(--muted); font-size: .9rem; }
  .leyenda-g { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: .9rem; margin: 0 0 4px; }
  .leyenda-g span { display: inline-flex; align-items: center; gap: 6px; }
  .leyenda-g i { width: 14px; height: 4px; display: inline-block; }
  .filtros select { font: inherit; color: var(--ink); background: var(--surface); border: 1px solid var(--line); border-radius: 4px; padding: 4px 6px; min-height: 36px; max-width: 100%; }
</style>
<script>
  // Gráfico de líneas en SVG propio: los años de cada indicador x hasta 6 provincias. Sin dependencias.
  const S = JSON.parse(document.getElementById("series")!.textContent!);
  const indEl = document.getElementById("g-ind") as HTMLSelectElement, provEl = document.getElementById("g-prov") as HTMLSelectElement;
  const el = document.getElementById("grafico")!;
  const PALETTE = ["#1F5FAD", "#B5651D", "#2E7D5B", "#7B4FA0", "#A13D63", "#5A6B7B"]; // categórica, sin connotación política
  const names = Object.fromEntries([...provEl.options].map((o) => [o.value, o.text]));
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]!));
  const nf = (v: number) => v.toLocaleString("es-ES", { maximumFractionDigits: 1 });
  function niceMax(v: number) { const p = Math.pow(10, Math.floor(Math.log10(v || 1))); return Math.ceil(v / p) * p; }
  function draw() {
    const sel = [...provEl.selectedOptions].map((o) => o.value).slice(0, 6);
    const s = S[indEl.value];
    const W = Math.max(320, el.clientWidth), H = 340, L = 72, R = 16, T = 40, B = 32;
    const all = sel.flatMap((id) => s.data[id]).filter((v: number | null) => v != null) as number[];
    const max = niceMax(Math.max(...all, 1));
    const yrs = s.per.map(Number), y0 = yrs[0], y1 = yrs[yrs.length - 1];
    const x = (i: number) => y1 === y0 ? (L + W - R) / 2 : L + ((yrs[i] - y0) * (W - L - R)) / (y1 - y0);
    const salto = (i: number) => yrs[i + 1] - yrs[i] > 1 && yrs[i + 1] >= 1940;
    const y = (v: number) => T + (H - T - B) * (1 - v / max);
    const ticks = [0, 0.25, 0.5, 0.75, 1].map((k) => k * max);
    let svg = `<svg viewBox="0 0 ${W} ${H}" width="100%" height="${H}" role="img" aria-label="${esc(s.concept)}: ${sel.map((id) => `${esc(names[id])} ${s.data[id].map((v: number | null) => v == null ? "sin dato" : nf(v)).join(", ")}`).join("; ")}">`;
    svg += ticks.map((t) => `<line x1="${L}" x2="${W - R}" y1="${y(t)}" y2="${y(t)}" stroke="var(--line)"/><text x="${L - 8}" y="${y(t) + 4}" text-anchor="end" font-size="12" fill="var(--muted)">${nf(t)}</text>`).join("");
    svg += s.per.map((c: string, i: number) => `<text x="${x(i)}" y="${H - 8}" text-anchor="middle" font-size="12" fill="var(--muted)">${c}</text>`).join("");
    svg += `<text x="${L}" y="16" font-size="12" fill="var(--muted)">${esc(s.unit)}</text>`;
    sel.forEach((id, k) => {
      const c = PALETTE[k], d = s.data[id];
      const pts = d.map((v: number | null, i: number) => v == null ? null : [x(i), y(v)]);
      for (let i = 0; i < pts.length - 1; i++) if (pts[i] && pts[i + 1]) svg += `<line x1="${pts[i][0]}" y1="${pts[i][1]}" x2="${pts[i + 1][0]}" y2="${pts[i + 1][1]}" stroke="${c}" stroke-width="2.5"${salto(i) ? ' stroke-dasharray="6 4"' : ""}/>`;
      pts.forEach((p: number[] | null, i: number) => { if (p) svg += `<circle cx="${p[0]}" cy="${p[1]}" r="5" fill="${c}" stroke="var(--surface)" stroke-width="2"><title>${esc(names[id])}, ${s.per[i]}: ${nf(d[i])}</title></circle>`; });
    });
    svg += "</svg>";
    const legend = `<p class="leyenda-g">${sel.map((id, k) => `<span><i style="background:${PALETTE[k]}"></i>${esc(names[id])}</span>`).join("")}${s.per.some((_: string, i: number) => i < s.per.length - 1 && salto(i)) ? `<span class="meta">Tramo 1930-1940 en discontinuo: censo de posguerra</span>` : ""}</p>`;
    el.innerHTML = legend + svg;
  }
  indEl.addEventListener("change", draw); provEl.addEventListener("change", draw);
  let rt: number; addEventListener("resize", () => { clearTimeout(rt); rt = window.setTimeout(draw, 150); });
  draw();
</script>
