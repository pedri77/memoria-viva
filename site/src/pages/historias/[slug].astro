---
import Base from "../../layouts/Base.astro";
import { stories, documents, places, byId, url } from "../../lib/data";
import { svgProvincias } from "../../lib/atlas";
import Facsimil from "../../components/Facsimil.astro";
import man from "../../data/facsimiles.json";
export function getStaticPaths() {
  return stories.map((s) => ({ params: { slug: s.id.replace("story-", "") }, props: { s } }));
}
const { s } = Astro.props;
const svg = svgProvincias(420);
const provNombre = (c: string) => places.find((p) => p.id === `plc-prov-${c}`)?.canonical_name ?? c;
const KIND: Record<string, string> = { documento: "Según el documento", hecho: "Hecho documentado", interpretacion: "Interpretación", estimacion: "Estimación" };
let n = 0;
const scenes = s.scenes.map((sc: any) => ({
  ...sc,
  claims: sc.claims.map((c: any) => ({ ...c, n: ++n, docs: c.evidence.map((e: any) => ({ ...e, d: byId(documents, e.document_id) })) })),
  codes: (sc.place_ids ?? []).map((p: string) => p.replace("plc-prov-", "")),
  facs: [...new Set(sc.claims.flatMap((c: any) => c.evidence.map((e: any) => e.document_id)))].filter((id: any) => (man as any)[id]),
}));
const draft = s.review.status !== "aprobado";
---
<Base title={s.title} description={s.summary}>
  <div class="progreso" aria-hidden="true"><span></span></div>
  <p class="meta"><a href={url("/historias/")}>Historias</a> · {s.period}</p>
  <h1>{s.title}</h1>
  {draft && <p class="aviso" role="note"><strong>Borrador en revisión.</strong> Cada afirmación está comprobada sobre su documento, pero la narrativa aún no ha pasado la revisión de dos especialistas. <a href={url("/metodologia/#correcciones")}>Cómo notificar un error</a>.</p>}
  <p class="entradilla">{s.summary}</p>

  <div class="historia">
    <div class="escenas">
      {scenes.map((sc: any) => (
        <section class="escena" id={sc.id} data-codes={sc.codes.join(",")} aria-labelledby={`h-${sc.id}`}>
          {sc.date_label && <p class="meta">{sc.date_label}</p>}
          <h2 id={`h-${sc.id}`}>{sc.heading}</h2>
          {sc.intro && <p class="intro">{sc.intro}</p>}
          {sc.claims.map((c: any) => (
            <p>
              {c.kind !== "documento" && <span class="tag" data-c={`k-${c.kind}`}>{KIND[c.kind]}</span>}{" "}
              {c.text}{c.attributed_to && <span class="meta"> (según {c.attributed_to})</span>}<sup><a href={`#nota-${c.n}`} id={`ref-${c.n}`} aria-label={`Fuente ${c.n}`}>{c.n}</a></sup>
            </p>
          ))}
          {sc.editorial_note && <p class="nota-ed"><strong>Nota editorial.</strong> {sc.editorial_note}</p>}
          <ol class="fuentes" aria-label={`Fuentes de «${sc.heading}»`}>
            {sc.claims.map((c: any) => c.docs.map((e: any, k: number) => (
              <li id={k === 0 ? `nota-${c.n}` : `nota-${c.n}-${k + 1}`} value={c.n}>
                <a href={url(`/documentos/${e.document_id}/`)}>{e.d?.title}</a>{e.locator ? `, ${e.locator}` : ""}.
                {" "}<a href={e.d?.canonical_url} rel="noopener">Original</a> · <a href={`#ref-${c.n}`} aria-label={`Volver a la afirmación ${c.n}`}>↑</a>
              </li>
            )))}
          </ol>
          {sc.facs.length > 0 && <div class="esc-facs" aria-label="Facsímiles de los documentos citados">{sc.facs.slice(0, 3).map((id: string) => <Facsimil id={id} tam="mini" pie={false} />)}</div>}
          {sc.atlas_query && <p class="meta"><a href={url(`/atlas/?${sc.atlas_query}`)}>Ver estas elecciones en el atlas</a></p>}
          {sc.event_ids?.length > 0 && <p class="meta">En la cronología: {sc.event_ids.map((id: string, i: number) => <>{i > 0 && " · "}<a href={url(`/acontecimientos/${id}/`)}>ficha</a></>)}</p>}
        </section>
      ))}
      <section class="escena" id="lagunas" aria-labelledby="h-lagunas" data-codes="">
        <h2 id="h-lagunas">Lo que esta historia todavía no cuenta</h2>
        <ul>{s.gaps.map((g: string) => <li>{g}</li>)}</ul>
        <p class="meta">La ausencia de un tema aquí no significa que no ocurriera: significa que aún no está documentado en este proyecto. Dónde se ha buscado y qué fuentes probar: <a href={url("/lagunas/")}>lagunas pendientes</a>.</p>
      </section>
    </div>
    <aside class="lateral" aria-hidden="true">
      <div class="pegajoso">
        <svg viewBox={`0 0 ${svg.width} ${svg.height}`} class="mini">
          {svg.paths.map((p) => <path d={p.d} data-code={p.code} data-tip={provNombre(p.code)} />)}
        </svg>
        <p class="meta" id="lat-txt">España, provincias de 1930.</p>
      </div>
    </aside>
  </div>
  <p class="meta">Revisión: {s.review.status}, {s.review.date}. {s.review.note}</p>
</Base>
<style is:global>
  .aviso { border-left: 4px solid var(--accent); background: var(--surface); padding: 12px 16px; }
  .entradilla { font-size: 1.1rem; }
  .historia { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 40px; }
  main > h1 { font-size: clamp(2.4rem, 1.4rem + 4vw, 4.4rem); letter-spacing: -0.03em; font-variation-settings: "opsz" 60; margin-top: .4em; }
  .escena > .meta:first-child { font-family: var(--serif); font-size: 1.35rem; color: var(--accent); margin: 0; font-variant-numeric: lining-nums; }
  .escena h2 { margin-top: .2em; }
  .esc-facs { display: flex; gap: 12px; margin: 12px 0; }
  .esc-facs .facsimil { width: 110px; flex: none; }
  .progreso { position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 20; pointer-events: none; }
  .progreso span { display: block; height: 100%; width: 100%; background: var(--accent); transform-origin: 0 50%; transform: scaleX(var(--p, 0)); }
  .escena { padding: 24px 0 40px; border-bottom: 1px solid var(--line); }
  .escena .intro { font-style: italic; color: var(--muted); }
  .escena sup a { text-decoration: none; padding: 0 2px; }
  .fuentes { font-size: .88rem; color: var(--muted); padding-left: 20px; }
  .nota-ed { font-size: .92rem; background: var(--surface); padding: 10px 14px; border-radius: 4px; }
  .lateral .pegajoso { position: sticky; top: 24px; }
  .mini { width: 100%; height: auto; }
  .mini path { fill: var(--line); stroke: var(--bg); stroke-width: .6; transition: fill .3s; }
  .mini path.on { fill: var(--accent); }
  .mini.todas path { fill: #7FA3B8; }
  @media (prefers-reduced-motion: reduce) { .mini path { transition: none; } }
  @media (max-width: 800px) { .historia { grid-template-columns: 1fr; } .lateral { display: none; } }
</style>
<script>
  const paths = [...document.querySelectorAll<SVGPathElement>(".mini path")];
  const mini = document.querySelector(".mini")!;
  const txt = document.getElementById("lat-txt")!;
  function show(codes: string[], heading: string) {
    mini.classList.toggle("todas", codes.length === 0);
    for (const p of paths) p.classList.toggle("on", codes.includes(p.dataset.code!));
    txt.textContent = codes.length ? `${heading}: provincias citadas en la escena` : `${heading}: ámbito estatal o sin lugar concreto`;
  }
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) {
      const el = e.target as HTMLElement;
      const codes = (el.dataset.codes || "").split(",").filter(Boolean);
      show(codes, el.querySelector("h2")?.textContent ?? "");
    }
  }, { rootMargin: "-40% 0px -55% 0px" });
  document.querySelectorAll(".escena").forEach((s) => io.observe(s));
  // Barra de progreso de lectura (ligada al scroll: la controla quien lee)
  const barra = document.querySelector<HTMLElement>(".progreso span");
  let pend = false;
  const prog = () => { pend = false; const h = document.documentElement.scrollHeight - innerHeight; barra?.style.setProperty("--p", String(h > 0 ? Math.min(1, scrollY / h) : 0)); };
  addEventListener("scroll", () => { if (!pend) { pend = true; requestAnimationFrame(prog); } }, { passive: true }); prog();
</script>
