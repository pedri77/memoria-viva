---
import Base from "../layouts/Base.astro";
import { sources } from "../lib/data";
const ESTADO: Record<string, string> = { candidate: "candidata", researched: "auditada", permission_pending: "permiso pendiente", pilot: "en piloto", production: "en uso", blocked: "bloqueada" };
---
<Base index={false} title="Fuentes" description="Registro de fuentes de España: Memoria Viva, con prioridad, estado y licencia.">
  <h1>Fuentes</h1>
  <p class="meta">Auditoría del 14-11-2026. «Prioridad» indica el orden de trabajo del piloto 1931-1939, no la importancia histórica de la institución.</p>
  <div class="table-wrap">
    <table>
      <thead><tr><th>ID</th><th>Fuente</th><th>Prioridad</th><th>Estado</th><th>Licencia</th><th>Acceso</th></tr></thead>
      <tbody>
        {sources.map((s) => (
          <tr>
            <td>{s.id}</td>
            <td><a href={s.url} rel="noopener">{s.name}</a><br /><span class="meta">{s.years}</span></td>
            <td>{s.priority}</td>
            <td>{ESTADO[s.status] ?? s.status}</td>
            <td>{s.license}</td>
            <td class="meta">{s.access}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>
