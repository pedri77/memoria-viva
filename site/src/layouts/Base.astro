---
import "@fontsource-variable/source-serif-4/opsz.css";
import "@fontsource-variable/source-serif-4/opsz-italic.css";
import "@fontsource-variable/inter";
import { url } from "../lib/data";
interface Props { title: string; description?: string; index?: boolean; wide?: boolean }
const { title, index = true, wide = false, description = "Atlas y archivo documental de la historia contemporánea de España. Cada afirmación enlaza a su fuente." } = Astro.props;
const NAV = [
  ["/atlas/", "Atlas"], ["/acontecimientos/", "Cronología"], ["/historias/", "Historias"], ["/documentos/", "Archivo"],
  ["/datos/", "Datos"], ["/fuentes/", "Fuentes"], ["/metodologia/", "Metodología"], ["/buscar/", "Buscar"],
];
const here = Astro.url.pathname;
const current = (p: string) => here.startsWith(url(p)) ? "page" : undefined;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Memoria Viva</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F0E9DB" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#17232F" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body class={wide ? "wide" : undefined}>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <header class="site">
      <a class="logo" href={url("/")} aria-current={here === url("/") ? "page" : undefined}>España: <em>Memoria Viva</em></a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav-principal">Menú</button>
      <nav id="nav-principal" aria-label="Principal">
        {NAV.map(([p, t]) => <a href={url(p)} aria-current={current(p)}>{t}</a>)}
      </nav>
    </header>
    <main id="contenido" data-pagefind-body={index ? "" : undefined}><slot /></main>
    <footer class="site">
      <p>Proyecto personal en construcción (fase F4: capa electoral 1931-1936). Textos y datos propios: CC BY-SA 4.0. Código: MIT. Los documentos pertenecen a sus custodios y se citan con su licencia.</p>
      <p><a href="https://github.com/pedri77/memoria-viva/issues/new?template=correccion.yml">Notificar un error</a> · <a href={url("/cambios/")}>Registro de cambios</a> · <a href={url("/lagunas/")}>Lagunas pendientes</a> · <a href="https://github.com/pedri77/memoria-viva">Código y datos</a></p>
    </footer>
    <script>
      const btn = document.querySelector<HTMLButtonElement>(".menu-btn");
      btn?.addEventListener("click", () => {
        const open = btn.getAttribute("aria-expanded") !== "true";
        btn.setAttribute("aria-expanded", String(open));
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && btn?.getAttribute("aria-expanded") === "true") { btn.setAttribute("aria-expanded", "false"); btn.focus(); }
      });
    </script>
  </body>
</html>
<style is:global>
  :root {
    --bg: #F0E9DB; --surface: #FBF8F1; --ink: #17232F; --muted: #4F5A63;
    --accent: #8D423C; --line: #D6BE94; --focus: #1F5FAD;
    --serif: "Source Serif 4 Variable", Georgia, serif;
    --sans: "Inter Variable", system-ui, sans-serif;
    --ease: cubic-bezier(.16, 1, .3, 1);
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #17232F; --surface: #1F2E3C; --ink: #F0E9DB; --muted: #A9ABA7;
      --accent: #D9958D; --line: #3A4B5B; --focus: #8AB4F8; color-scheme: dark;
    }
  }
  :root[data-theme="dark"] {
    --bg: #17232F; --surface: #1F2E3C; --ink: #F0E9DB; --muted: #A9ABA7;
    --accent: #D9958D; --line: #3A4B5B; --focus: #8AB4F8; color-scheme: dark;
  }
  @view-transition { navigation: auto; }
  @media (prefers-reduced-motion: reduce) { @view-transition { navigation: none; } }
  ::view-transition-old(root), ::view-transition-new(root) { animation-duration: .28s; animation-timing-function: var(--ease); }
  header.site { view-transition-name: cabecera; }

  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 17px/1.6 var(--sans); -webkit-font-smoothing: antialiased; }
  h1, h2, h3 { font-family: var(--serif); line-height: 1.2; text-wrap: balance; font-weight: 600; letter-spacing: -0.01em; }
  h1 { font-size: clamp(2rem, 1.4rem + 2.6vw, 3.1rem); line-height: 1.08; letter-spacing: -0.02em; margin: 1.2em 0 .5em; }
  h2 { font-size: clamp(1.4rem, 1.2rem + .9vw, 1.85rem); margin: 1.6em 0 .5em; }
  p { text-wrap: pretty; }
  main p, main li { max-width: 72ch; }
  ::selection { background: color-mix(in srgb, var(--accent) 28%, transparent); }
  a { color: var(--accent); text-underline-offset: 3px; text-decoration-thickness: 1px; }
  a:hover { text-decoration-thickness: 2px; }
  a:focus-visible, button:focus-visible, select:focus-visible, input:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; border-radius: 2px; }
  .skip { position: absolute; left: -999px; } .skip:focus { left: 16px; top: 8px; background: var(--surface); padding: 8px; z-index: 10; }
  header.site, footer.site, main { max-width: 960px; margin: 0 auto; padding: 0 16px; }
  body.wide main { max-width: none; padding: 0; }

  header.site { position: relative; z-index: 5; display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: center; justify-content: space-between; padding-top: 18px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  body.wide header.site { max-width: 1240px; padding-left: 24px; padding-right: 24px; border-bottom-color: transparent; }
  .logo { font-family: var(--serif); font-weight: 600; font-size: 1.2rem; color: var(--ink); text-decoration: none; letter-spacing: -0.01em; }
  .logo em { font-style: italic; font-weight: 500; color: var(--accent); }
  nav { display: flex; flex-wrap: wrap; gap: 4px 20px; font-size: .95rem; }
  nav a { color: var(--ink); text-decoration: none; padding: 4px 0; background: linear-gradient(var(--accent), var(--accent)) 0 100% / 0 2px no-repeat; transition: background-size .35s var(--ease); }
  nav a:hover, nav a[aria-current="page"] { background-size: 100% 2px; }
  nav a[aria-current="page"] { color: var(--accent); }
  .menu-btn { display: none; }
  @media (max-width: 760px) {
    html.js .menu-btn { display: inline-flex; align-items: center; gap: 8px; font: 600 .95rem var(--sans); color: var(--ink); background: none; border: 1px solid var(--line); border-radius: 999px; padding: 6px 14px; cursor: pointer; }
    html.js .menu-btn::after { content: ""; width: 10px; height: 6px; background: currentColor; clip-path: polygon(0 0, 100% 0, 50% 100%); transition: transform .3s var(--ease); }
    html.js .menu-btn[aria-expanded="true"]::after { transform: rotate(180deg); }
    html.js nav { display: none; grid-template-columns: 1fr 1fr; width: 100%; gap: 0 16px; }
    html.js .menu-btn[aria-expanded="true"] + nav { display: grid; animation: menu-in .35s var(--ease); }
    @keyframes menu-in { from { opacity: 0; transform: translateY(-6px); } }
    @media (prefers-reduced-motion: reduce) { html.js .menu-btn[aria-expanded="true"] + nav { animation: none; } }
    html.js nav a { padding: 10px 0; border-top: 1px solid var(--line); background: none; font-size: 1.05rem; }
  }

  footer.site { margin-top: 64px; padding-top: 16px; padding-bottom: 32px; border-top: 1px solid var(--line); color: var(--muted); font-size: .9rem; }
  body.wide footer.site { max-width: 1240px; padding-left: 24px; padding-right: 24px; margin-top: 0; }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: 6px; padding: 16px 20px; margin: 16px 0; }
  .meta { color: var(--muted); font-size: .9rem; }
  .tag { display: inline-block; border: 1px solid var(--line); border-radius: 999px; padding: 0 10px; font-size: .8rem; color: var(--muted); }
  table { width: 100%; border-collapse: collapse; font-size: .92rem; font-variant-numeric: tabular-nums; }
  th, td { text-align: left; padding: 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .table-wrap { overflow-x: auto; }
  dl { display: grid; grid-template-columns: max-content 1fr; gap: 4px 16px; } dt { color: var(--muted); }
  @media (max-width: 600px) { dl { grid-template-columns: 1fr; } dt { margin-top: 8px; } }
</style>
