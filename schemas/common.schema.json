{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memoria-viva/schemas/common.schema.json",
  "title": "Definiciones comunes",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]+-[a-z0-9-]+$"
    },
    "fecha_iso": {
      "type": "string",
      "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
    },
    "precision": {
      "enum": [
        "dia",
        "mes",
        "anio",
        "decada",
        "aproximada",
        "intervalo",
        "desconocida"
      ]
    },
    "rights": {
      "type": "object",
      "required": [
        "status",
        "action",
        "evidence_url",
        "checked_at"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "public_domain",
            "cc0",
            "cc_by",
            "cc_by_sa",
            "cc_by_nc",
            "cc_by_nc_sa",
            "reuse_conditions",
            "link_only",
            "restricted"
          ]
        },
        "action": {
          "enum": [
            "enlazar",
            "mostrar_miniatura",
            "almacenar",
            "descargar"
          ]
        },
        "attribution": {
          "type": "string"
        },
        "evidence_url": {
          "type": "string",
          "format": "uri"
        },
        "checked_at": {
          "$ref": "#/$defs/fecha_iso"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "status",
        "date",
        "by"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "borrador",
            "revision",
            "aprobado",
            "retirado"
          ]
        },
        "date": {
          "$ref": "#/$defs/fecha_iso"
        },
        "by": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "note": {
          "type": "string"
        }
      }
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^F\\d{3}$"
      },
      "minItems": 1
    },
    "evidence": {
      "type": "object",
      "required": [
        "document_id"
      ],
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "$ref": "#/$defs/id"
        },
        "locator": {
          "type": "string",
          "description": "página, folio o párrafo"
        },
        "quote": {
          "type": "string",
          "maxLength": 400
        }
      }
    }
  }
}
